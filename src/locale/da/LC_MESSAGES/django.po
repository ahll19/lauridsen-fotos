msgid "Gallery no longer available"
msgstr "Galleriet er ikke længere tilgængeligt"

msgid "This gallery is no longer available"
msgstr "Dette galleri er ikke længere tilgængeligt"

#, python-format
msgid ""
"\n"
"        The photographs in this gallery were available until %(date)s and have since "
"been\n"
"        deleted.\n"
