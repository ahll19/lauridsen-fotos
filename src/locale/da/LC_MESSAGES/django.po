#: templates/pages/contact.html
msgid "Thank you — your message has been sent. I'll be in touch soon."
msgstr "Tak — din besked er sendt. Jeg vender tilbage hurtigst muligt."

msgid "Leave this empty"
msgstr "Lad dette felt være tomt"

msgid "Send message"
msgstr "Send besked"

msgid "Or reach me directly"
msgstr "Eller fang mig direkte"

