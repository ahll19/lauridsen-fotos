msgstr "Dette galleri er beskyttet med adgangskode. Indtast den kode du har fået."

msgid "Password"
msgstr "Adgangskode"

msgid "Open gallery"
msgstr "Åbn galleri"

#: galleries/views.py
msgid "That password is not correct."
msgstr "Adgangskoden er ikke korrekt."

