# Rendered by Ansible (roles/app/templates/env.j2). Do not edit on the host: the next
# deploy overwrites it. Change the inventory or the vault and deploy again.
#
# Every key in .env.example appears here — scripts/verify.sh checks that — so a setting
# added for development cannot be forgotten in production.

# --- Compose -----------------------------------------------------------------
COMPOSE_FILE={{ (['docker-compose.yml', 'docker-compose.prod.yml'] + compose_extra_files) | join(':') }}
COMPOSE_PROFILES={{ (['prod'] + (tls_enabled | ternary(['tls'], []))) | join(',') }}

# --- Where the stack listens -------------------------------------------------
HTTP_PORT={{ http_port }}
HTTPS_PORT={{ https_port }}
# No Mailpit on the server; kept so the key set matches .env.example.
MAIL_UI_PORT=8025
NGINX_MODE={{ tls_enabled | ternary('https', 'http') }}
SERVER_NAMES={{ site_domains | join(' ') }}
# Filenames are content-hashed with DJANGO_DEBUG=0, so they may be cached for good.
STATIC_CACHE_CONTROL="public, max-age=2592000, immutable"
TRUSTED_PROXY_COUNT={{ trusted_proxy_count }}

# --- Persistent data ---------------------------------------------------------
DATA_DIR={{ data_dir }}

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY={{ django_secret_key }}
DJANGO_DEBUG=0
# 127.0.0.1 is the container's own health check, which asks the application directly.
DJANGO_ALLOWED_HOSTS={{ (site_domains + ['127.0.0.1']) | join(',') }}
DJANGO_CSRF_TRUSTED_ORIGINS={{ site_domains | map('regex_replace', '^', tls_enabled | ternary('https://', 'http://')) | join(',') }}
DJANGO_TIME_ZONE={{ django_time_zone }}
DJANGO_LANGUAGE_CODE={{ django_language_code }}
DJANGO_SERVE_OVER_HTTPS={{ tls_enabled | ternary(1, 0) }}
DJANGO_HSTS_SECONDS={{ django_hsts_seconds }}
DJANGO_LOG_LEVEL={{ django_log_level }}
DJANGO_ADMIN_PATH={{ django_admin_path }}
{% if django_csp is defined %}
DJANGO_CSP={{ django_csp }}
{% endif %}
DJANGO_CSP_REPORT_ONLY={{ django_csp_report_only | default(0) }}

# --- Application server ------------------------------------------------------
APP_PORT={{ app_port }}
GUNICORN_WORKERS={{ gunicorn_workers }}
GUNICORN_TIMEOUT={{ gunicorn_timeout }}
MAX_UPLOAD_SIZE={{ max_upload_size }}

# --- Scheduled jobs ----------------------------------------------------------
CRON_SCHEDULE_EXPIRE_GALLERIES="{{ cron_schedule_expire_galleries }}"
CRON_SCHEDULE_PURGE_TOMBSTONES="{{ cron_schedule_purge_tombstones }}"

# --- Client galleries --------------------------------------------------------
GALLERY_DEFAULT_EXPIRY_DAYS={{ gallery_default_expiry_days }}
GALLERY_TOMBSTONE_RETENTION_DAYS={{ gallery_tombstone_retention_days }}
GALLERY_SESSION_MAX_AGE={{ gallery_session_max_age }}
GALLERY_UNLOCK_RATELIMIT={{ gallery_unlock_ratelimit }}
USE_X_ACCEL=1

# --- Mail relay --------------------------------------------------------------
EMAIL_HOST=mail-relay
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL={{ mail_from_address }}
SERVER_EMAIL={{ mail_from_address }}
OWNER_EMAIL={{ owner_email }}
MAIL_HOSTNAME={{ mail_hostname }}
MAIL_SENDER_DOMAIN={{ mail_sender_domain }}
MAIL_DKIM_KEYS_DIR={{ app_dir }}/shared/dkim
DKIM_SELECTOR={{ dkim_selector }}

# --- Spam protection ---------------------------------------------------------
CONTACT_RATELIMIT={{ contact_ratelimit }}

# --- Certificates ------------------------------------------------------------
CERT_DOMAINS={{ site_domains | join(',') }}
LETSENCRYPT_EMAIL={{ letsencrypt_email }}
LETSENCRYPT_AGREE_TOS={{ letsencrypt_agree_tos | ternary(1, 0) }}
CERTBOT_SERVER={{ certbot_server }}
CERTBOT_EXTRA_ARGS={{ certbot_extra_args }}
CERTBOT_RENEW_INTERVAL={{ certbot_renew_interval }}
CERTBOT_RETRY_INTERVAL={{ certbot_retry_interval }}
CERT_RELOAD_INTERVAL={{ cert_reload_interval }}

# --- Pinned images -----------------------------------------------------------
# Mailpit never runs here; kept so the key set matches .env.example.
MAILPIT_IMAGE=axllent/mailpit:latest
POSTFIX_IMAGE={{ postfix_image }}
CERTBOT_IMAGE={{ certbot_image }}
