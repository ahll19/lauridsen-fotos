#!/usr/bin/env bash
#
# Enforces Conventional Commits.
#
# The release script derives the next version number and the changelog from these messages,
# so a message that doesn't parse silently degrades releases later.
#
set -euo pipefail

msg_file="$1"
subject=$(grep -vE '^\s*#' "$msg_file" | sed '/^\s*$/d' | head -n1)

# Merges, reverts and fixups are generated by git itself and are exempt.
if [[ "$subject" =~ ^(Merge|Revert|fixup!|squash!) ]]; then
    exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'

if [[ ! "$subject" =~ $pattern ]]; then
    cat >&2 <<EOF
✗ Commit message does not follow Conventional Commits.

  Got:      $subject

  Expected: <type>(<optional scope>): <subject>
  Types:    feat fix docs style refactor perf test build ci chore revert
  Breaking: append ! after the type, e.g. feat!: require MEDIA_ROOT env var

  Examples:
    feat(gallery): add password gate to client galleries
    fix(thumbnails): honour EXIF orientation when resizing
    chore: pin django to 5.2.4
EOF
    exit 1
fi

if (( ${#subject} > 72 )); then
    echo "✗ Subject line is ${#subject} characters; keep it under 72." >&2
    exit 1
fi

# The subject itself (after the type prefix) should be imperative and lowercase.
body_of_subject=${subject#*: }
if [[ "$body_of_subject" =~ ^[A-Z][a-z] ]]; then
    echo "✗ Subject should start lowercase: '$body_of_subject'" >&2
    exit 1
fi

exit 0
