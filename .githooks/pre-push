#!/usr/bin/env bash
#
# Refuses direct pushes to main.
#
# This repository is private on a free GitHub plan, where GitHub cannot enforce branch
# protection server-side. This hook is the substitute. It is bypassable with --no-verify,
# which is exactly why CLAUDE.md forbids that flag.
#
# Annotated tags are allowed through, because that is how releases are published.
#
set -euo pipefail

PROTECTED="main"

while read -r _local_ref local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/"$PROTECTED")
            echo "✗ Refusing to push directly to '$PROTECTED'." >&2
            echo >&2
            if [[ "$local_sha" =~ ^0+$ ]]; then
                echo "  You are trying to delete the protected branch." >&2
            else
                echo "  Open a pull request instead:" >&2
                echo "    scripts/new-branch.sh <type> <slug>   # start the work on a branch" >&2
                echo "    gh pr create                          # once it is committed" >&2
            fi
            exit 1
            ;;
    esac
done

exit 0
