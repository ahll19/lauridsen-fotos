# Rendered by the nginx image's envsubst at container start.
#
# NGINX_MODE picks which server block answers: `http` on a laptop, where there is no
# certificate, and `https` on the VPS. Both are rendered into conf.d/servers/, which nginx
# does not load by itself, and exactly one is included here.

upstream app_server {
    server ${APP_HOST}:${APP_PORT};
}

include /etc/nginx/conf.d/servers/${NGINX_MODE}.inc;
