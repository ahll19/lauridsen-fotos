# HTTPS, terminated here and nowhere else (architecture.md §7).
#
# Port 80 does two things only: answer Let's Encrypt's HTTP-01 challenge out of the
# directory certbot writes into, and send everything else to HTTPS.
server {
    listen 80;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAMES};

    # Not certbot's own live/ directory. That one does not exist until the first
    # certificate has been issued, and nginx will not start without a certificate to
    # read — so certbot keeps a copy here, and puts a short-lived self-signed one in its
    # place until the real one arrives (docker/certbot/certbot-loop.sh).
    ssl_certificate     /etc/letsencrypt/active/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/active/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/conf.d/snippets/site.inc;
}

# A request for a name this site does not answer to gets no page and no certificate
# worth trusting, rather than the site under someone else's hostname.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate     /etc/letsencrypt/active/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/active/privkey.pem;
    return 444;
}
