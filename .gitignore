# --- Secrets & local environment ---
.env
.env.*
!.env.example

# The ansible-vault password. Encrypted vault files ARE committed (see
# docs/decisions/0002-manage-the-host-with-ansible.md); the password that opens them
# never is — it belongs in a password manager.
.vault-pass
.vault_pass
*.vault-pass
vault-password*
ansible/.vault*

# --- Application data (bind-mounted /data: SQLite DB, media, thumbnail cache) ---
data/
*.sqlite3
*.sqlite3-journal

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/
.venv/
venv/
env/

# --- Django ---
staticfiles/
mediafiles/
*.log
# Compiled translation catalogues: generated from the .po files by the entrypoint.
*.mo

# --- Tooling / editors ---
.vscode/
.idea/
.claude/settings.local.json
.DS_Store
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- TLS / certbot state (never committed) ---
certbot/
letsencrypt/
