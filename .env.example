# Copy to .env and adjust. Never commit .env — it is gitignored.
#
#   cp .env.example .env
#   scripts/dev.sh up
#
# Every value the stack needs is here. Nothing operational (ports, schedules, retention
# windows, paths) is hardcoded in the images, the compose file, or the application.
#
# ==============================================================================
#  EVERY DEFAULT BELOW IS FOR LOCAL DEVELOPMENT ONLY.
#
#  This file is committed, so anything in it is public knowledge. Copying it onto a
#  server unchanged would leave the site running with a signing key, an admin path and
#  a debug flag that anyone reading this repository already knows.
#
#  The production .env is not written by hand: it is rendered by the Ansible playbooks
#  from values held in an ansible-vault encrypted file. Generate each secret once, put
#  it in the vault, and never paste it into a shell where it lands in history.
#
#    DJANGO_SECRET_KEY    python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#                         Signs session cookies, the client-gallery unlock cookie and
#                         password-reset links. The application refuses to start with
#                         DJANGO_DEBUG=0 if this is still one of the example values.
#
#    DJANGO_ADMIN_PATH    python3 -c "import secrets; print(secrets.token_urlsafe(12))"
#                         A shared secret on top of the admin password, so the login
#                         form is not sitting at a path every scanner tries.
#
#    admin password       scripts/dev.sh superuser, typed at the prompt. Django never
#                         stores it in readable form; put a copy in the password manager.
#
#    DKIM signing key     opendkim-genkey, as described under the Postfix section below.
#
#    vault password       Generated in and kept only in the password manager. Losing it
#                         means losing every other secret here (ADR 0002).
#
#  Gallery passwords are not in this file at all — the application generates one per
#  gallery, shows it once, and stores only a hash.
# ==============================================================================

# --- Where the stack listens -------------------------------------------------
# The reverse proxy's public port. Change if 8080 is taken on your machine.
HTTP_PORT=8080
# Mailpit's web UI (local development only — in production this is a real relay with no UI).
MAIL_UI_PORT=8025

# How nginx tells browsers to cache /static/. "immutable" is a promise that the bytes at a
# URL will never change, so it is only ever correct when the filename carries a content
# hash — which it does with DJANGO_DEBUG=0 (ManifestStaticFilesStorage) and does not in
# development. Getting this wrong means an edited stylesheet that browsers refuse to
# re-fetch for a month, with no reload that helps.
#   development: public, max-age=0, must-revalidate
#   production:  public, max-age=2592000, immutable
STATIC_CACHE_CONTROL="public, max-age=0, must-revalidate"

# How many reverse proxies stand in front of the application. Every request arrives from
# nginx, so without this the application would see one address for every visitor on earth
# and rate-limit them all as a single caller. Raise it only if something else (a CDN) is
# ever put in front of nginx; the value is how many hops at the trusted end of
# X-Forwarded-For belong to us.
TRUSTED_PROXY_COUNT=1

# --- Persistent data ---------------------------------------------------------
# Host path bind-mounted to /data in the containers: SQLite database, uploaded media,
# and the disposable thumbnail cache. On the VPS this becomes an absolute path.
DATA_DIR=./data

# --- Django ------------------------------------------------------------------
# Generate a real one for anything non-local:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-insecure-key-replace-before-deploying
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_TIME_ZONE=Europe/Copenhagen
DJANGO_LANGUAGE_CODE=da

# Whether the site is actually reached over HTTPS. Defaults to the opposite of
# DJANGO_DEBUG, which is right everywhere except one case: running the production
# configuration locally to check it, where nginx has no certificate. Left on there, the
# site would redirect every request to an https:// port nothing listens on, and the
# browser would throw away the session and CSRF cookies because they are marked Secure —
# so the admin could not be logged into and no form could be submitted.
# scripts/prodcheck.sh sets this to 0 for exactly that reason. It must be 1 on the VPS.
#DJANGO_SERVE_OVER_HTTPS=1

# The Content-Security-Policy sent with every page. Unset means the built-in default,
# which allows nothing that does not come from this site. Override it to permit a new
# embed (a map, a video host); `off` sends no policy. REPORT_ONLY=1 sends the policy
# without enforcing it, so a tighter one can be tried on the live site first.
#DJANGO_CSP=default-src 'self'
#DJANGO_CSP_REPORT_ONLY=0

# The admin is mounted at this path rather than a fixed /admin/. In production this is a
# shared secret — pick something unguessable and keep it out of version control.
DJANGO_ADMIN_PATH=studio-admin/

# --- Application server ------------------------------------------------------
APP_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
# Largest file a visitor (really: the owner, uploading photos) may POST.
MAX_UPLOAD_SIZE=100m

# --- Scheduled jobs ----------------------------------------------------------
# Standard five-field cron expressions, rendered into the app-cron container's crontab
# at startup. Change them here, not in the image.
#
# Quoted because scripts/dev.sh reads this file with the shell: unquoted, `0 3 * * *`
# parses as an assignment of "0" followed by an attempt to run a command called `3`, the
# asterisks are expanded against the repository, and the variable ends up unset. Compose
# strips the quotes, so the containers see the same value either way. Any value containing
# a space or a glob character needs the same treatment.
CRON_SCHEDULE_EXPIRE_GALLERIES="0 3 * * *"
CRON_SCHEDULE_PURGE_TOMBSTONES="30 3 * * *"

# --- Client galleries --------------------------------------------------------
# Default lifetime of a new gallery, overridable per gallery in the admin.
GALLERY_DEFAULT_EXPIRY_DAYS=90
# How long an expired gallery's URL keeps answering "no longer available" before the
# tombstone row itself is deleted.
GALLERY_TOMBSTONE_RETENTION_DAYS=30
# How long a client stays unlocked after entering the password, in seconds.
GALLERY_SESSION_MAX_AGE=86400
# Password attempts allowed per caller. Generous — a client mistyping a pasted password a
# few times must not be locked out — but not unlimited.
GALLERY_UNLOCK_RATELIMIT=20/h
# Serve private files by handing off to nginx (X-Accel-Redirect). Set to 0 only when
# running manage.py runserver directly, without nginx in front.
USE_X_ACCEL=1

# --- Mail relay --------------------------------------------------------------
# Which relay runs. `dev` is Mailpit, which captures every message and shows it at
# http://localhost:8025 instead of delivering it. `prod` is Postfix, which delivers for
# real. Nothing else uses compose profiles, so this is effectively the mail switch.
COMPOSE_PROFILES=dev

# Both relays answer to the name `mail-relay` on the Docker network, so only the port
# changes between them: Mailpit listens on 1025, Postfix on 587 (the submission port —
# it deliberately does not expose 25). Change these two together with COMPOSE_PROFILES.
EMAIL_HOST=mail-relay
EMAIL_PORT=1025
# Left empty on purpose: the relay is reachable only from inside the Docker network and
# has no accounts. They exist for the case of ever pointing at an external smarthost.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0

# The address the site sends *as*. In production its domain must match
# MAIL_SENDER_DOMAIN below, or the relay refuses the message — and must be a domain whose
# SPF and DKIM records name this server, or receivers refuse it.
DEFAULT_FROM_EMAIL=no-reply@lauridsen-fotos.local
SERVER_EMAIL=no-reply@lauridsen-fotos.local
# Where contact-form submissions and Django error reports are sent. A real mailbox you
# read — in production this is not on the site's own domain.
OWNER_EMAIL=anders@lauridsen-fotos.local

# --- Postfix (COMPOSE_PROFILES=prod only) -------------------------------------
# Unused locally. Mail is delivered straight to each recipient's mail server rather than
# through a commercial sending service (ADR 0004), which means the three settings below
# have to agree with DNS or the mail is refused or filed as spam.
#
# The name the relay gives when greeting a recipient. It must resolve to the VPS, and the
# VPS's reverse DNS (set in the Hetzner console) must resolve back to it. A mismatch is
# the single most common reason self-hosted mail is rejected outright.
MAIL_HOSTNAME=mail.lauridsen-fotos.dk
# The only domain this relay will send as. Anything else is refused, which is what stops
# it being useful to a spammer who finds it.
MAIL_SENDER_DOMAIN=lauridsen-fotos.dk
# Where the DKIM signing keys live, as <domain>.private. Generate with:
#   opendkim-genkey -b 2048 -h rsa-sha256 -r -s mail -d lauridsen-fotos.dk
# then publish the matching .txt as a TXT record at mail._domainkey.<domain>.
MAIL_DKIM_KEYS_DIR=./docker/mail/dkim

# --- Spam protection ---------------------------------------------------------
# django-ratelimit rate for the contact form, as <count>/<period>.
CONTACT_RATELIMIT=5/h

# --- Pinned images -----------------------------------------------------------
# Named per service rather than one MAIL_RELAY_IMAGE for both. The two relays are not
# interchangeable, and a single variable meant an .env carrying the old Mailpit value
# quietly started Mailpit under the name `postfix` — a relay that accepts every message
# and delivers none of them, with nothing in the logs to say so.
MAILPIT_IMAGE=axllent/mailpit:latest
POSTFIX_IMAGE=boky/postfix:v5.1.0-alpine
