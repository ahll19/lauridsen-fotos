# Copy to .env and adjust. Never commit .env — it is gitignored.
#
#   cp .env.example .env
#   scripts/dev.sh up
#
# Every value the stack needs is here. Nothing operational (ports, schedules, retention
# windows, paths) is hardcoded in the images, the compose file, or the application.

# --- Where the stack listens -------------------------------------------------
# The reverse proxy's public port. Change if 8080 is taken on your machine.
HTTP_PORT=8080
# Mailpit's web UI (local development only — in production this is a real relay with no UI).
MAIL_UI_PORT=8025

# --- Persistent data ---------------------------------------------------------
# Host path bind-mounted to /data in the containers: SQLite database, uploaded media,
# and the disposable thumbnail cache. On the VPS this becomes an absolute path.
DATA_DIR=./data

# --- Django ------------------------------------------------------------------
# Generate a real one for anything non-local:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-insecure-key-replace-before-deploying
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_TIME_ZONE=Europe/Copenhagen
DJANGO_LANGUAGE_CODE=da

# The admin is mounted at this path rather than a fixed /admin/. In production this is a
# shared secret — pick something unguessable and keep it out of version control.
DJANGO_ADMIN_PATH=studio-admin/

# --- Application server ------------------------------------------------------
APP_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
# Largest file a visitor (really: the owner, uploading photos) may POST.
MAX_UPLOAD_SIZE=100m

# --- Scheduled jobs ----------------------------------------------------------
# Standard five-field cron expressions, rendered into the app-cron container's crontab
# at startup. Change them here, not in the image.
CRON_SCHEDULE_EXPIRE_GALLERIES=0 3 * * *
CRON_SCHEDULE_PURGE_TOMBSTONES=30 3 * * *

# --- Client galleries --------------------------------------------------------
# Default lifetime of a new gallery, overridable per gallery in the admin.
GALLERY_DEFAULT_EXPIRY_DAYS=90
# How long an expired gallery's URL keeps answering "no longer available" before the
# tombstone row itself is deleted.
GALLERY_TOMBSTONE_RETENTION_DAYS=30
# How long a client stays unlocked after entering the password, in seconds.
GALLERY_SESSION_MAX_AGE=86400
# Serve private files by handing off to nginx (X-Accel-Redirect). Set to 0 only when
# running manage.py runserver directly, without nginx in front.
USE_X_ACCEL=1

# --- Email -------------------------------------------------------------------
EMAIL_HOST=mail-relay
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=no-reply@lauridsen-fotos.local
SERVER_EMAIL=no-reply@lauridsen-fotos.local
# Where contact-form submissions and Django error reports are sent.
OWNER_EMAIL=anders@lauridsen-fotos.local

# --- Spam protection ---------------------------------------------------------
# django-ratelimit rate for the contact form, as <count>/<period>.
CONTACT_RATELIMIT=5/h

# --- Images which service images are used ------------------------------------
# Swapped for a real outbound-only Postfix relay when the VPS exists; Mailpit catches
# everything locally and shows it in a web UI instead of delivering it.
MAIL_RELAY_IMAGE=axllent/mailpit:latest
